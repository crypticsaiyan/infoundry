# Kestra API URL (default: http://localhost:8080)
KESTRA_API_URL=http://localhost:8080

# Kestra Tenant (default: main)
KESTRA_TENANT=main

# Authentication (Option 1: API Token)
# KESTRA_API_TOKEN=your-api-token-here

# Authentication (Option 2: Username/Password)
# KESTRA_USERNAME=your-username
# KESTRA_PASSWORD=your-password
